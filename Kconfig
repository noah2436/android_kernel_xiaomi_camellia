mainmenu "Linux/$ARCH $KERNELVERSION Kernel Configuration"

config SRCARCH
	string
	option env="SRCARCH"

source "arch/$SRCARCH/Kconfig"

config FORCE_KSU_MANUAL
	bool "Force KSU Manual Hook"
	default y
	select KSU_MANUAL_HOOK

